#!/bin/sh
# Pre-push hook: ensures frozen files, types, lint, and tests pass before pushing to remote

echo "=== Running pre-push checks ==="

echo "1/4 Running frozen files verification (npm run check:frozen)..."
npm run check:frozen
if [ $? -ne 0 ]; then
  echo "❌ Frozen file verification failed! The Edit is locked against modification. See AGENTS.md"
  exit 1
fi

echo "2/4 Running TypeScript check (npm run typecheck)..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed! Fix type errors before pushing."
  exit 1
fi

echo "3/4 Running ESLint check (npm run lint -- --quiet)..."
npm run lint -- --quiet
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed with errors! Fix lint errors before pushing."
  exit 1
fi

echo "4/4 Running Vitest test suite (npm test)..."
npm test
if [ $? -ne 0 ]; then
  echo "❌ Vitest test suite failed! Fix failing tests before pushing."
  exit 1
fi

echo "✓ All pre-push checks passed successfully!"
exit 0
